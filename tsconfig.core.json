{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "WebWorker", "WebWorker.Iterable"],
    "types": [],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/core/**/*.mjs",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/core/**/*.test.ts",
    "src/core/**/*.spec.ts",
    "src/shared/**/*.test.ts",
    "src/shared/**/*.spec.ts"
  ]
}
